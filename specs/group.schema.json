{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toeic-ios-app.local/schemas/group.schema.json",
  "title": "TOEIC Content Contract 1.0.0 Group",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "group_id",
    "version",
    "family_id",
    "pool",
    "fixture",
    "part",
    "layout",
    "scenario",
    "difficulty",
    "content_status",
    "stimulus",
    "assets",
    "items",
    "provenance",
    "review_refs"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "group_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "family_id": { "type": "string", "minLength": 1 },
    "pool": { "type": "string", "enum": ["training", "battle", "diagnostic", "mock"] },
    "fixture": { "type": "boolean" },
    "part": { "type": "integer", "minimum": 1, "maximum": 7 },
    "layout": {
      "type": "string",
      "enum": [
        "photo",
        "question_response",
        "conversation",
        "talk",
        "sentence",
        "text_completion",
        "single_passage",
        "double_passage",
        "triple_passage"
      ]
    },
    "scenario": { "type": "string", "minLength": 1 },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rationale_zh", "basis"],
      "properties": {
        "level": { "type": "string", "enum": ["D1", "D2", "D3", "D4", "D5"] },
        "rationale_zh": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "const": "editorial" }
      }
    },
    "content_status": {
      "type": "string",
      "enum": ["draft", "ai_checked", "human_reviewed", "quarantined", "retired"]
    },
    "stimulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "speakers", "audio_script"],
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "genre", "title_en", "blocks"],
            "properties": {
              "document_id": { "type": "string", "minLength": 1 },
              "genre": { "type": "string", "minLength": 1 },
              "title_en": { "type": "string" },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["block_id", "type"],
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "required": ["block_id", "type", "text_en"],
                      "properties": {
                        "block_id": { "type": "string", "minLength": 1 },
                        "type": { "type": "string", "const": "text" },
                        "text_en": { "type": "string", "minLength": 1 }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "required": ["block_id", "type", "columns", "rows"],
                      "properties": {
                        "block_id": { "type": "string", "minLength": 1 },
                        "type": { "type": "string", "const": "table" },
                        "columns": {
                          "type": "array",
                          "minItems": 1,
                          "items": { "type": "string" }
                        },
                        "rows": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "speakers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker_id", "role", "accent"],
            "properties": {
              "speaker_id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "accent": { "type": "string", "enum": ["us", "uk", "ca", "au", "unspecified"] }
            }
          }
        },
        "audio_script": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "speaker_id", "text_en"],
            "properties": {
              "segment_id": { "type": "string", "minLength": 1 },
              "speaker_id": { "type": "string", "minLength": 1 },
              "text_en": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "kind",
          "status",
          "path",
          "sha256",
          "mime_type",
          "duration_ms",
          "source_note_zh",
          "review_state",
          "segment_times"
        ],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["image", "audio"] },
          "status": { "type": "string", "enum": ["planned", "ready"] },
          "path": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "mime_type": { "type": ["string", "null"] },
          "duration_ms": { "type": ["integer", "null"], "minimum": 1 },
          "source_note_zh": { "type": "string", "minLength": 1 },
          "review_state": { "type": "string", "enum": ["pending", "ai_checked", "human_reviewed"] },
          "segment_times": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segment_id", "start_ms", "end_ms"],
              "properties": {
                "segment_id": { "type": "string", "minLength": 1 },
                "start_ms": { "type": "integer", "minimum": 0 },
                "end_ms": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "prompt_en",
          "choices",
          "answer_choice_id",
          "skill_tags",
          "evidence",
          "explanation_zh",
          "distractor_notes",
          "vocabulary",
          "estimated_time_sec"
        ],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "prompt_en": { "type": "string", "minLength": 1 },
          "choices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text_en"],
              "properties": {
                "id": { "type": "string", "enum": ["A", "B", "C", "D"] },
                "text_en": { "type": "string", "minLength": 1 }
              }
            }
          },
          "answer_choice_id": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "skill_tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "photo_action",
                "photo_state_location",
                "question_function",
                "direct_response",
                "indirect_response",
                "main_idea_purpose",
                "explicit_detail",
                "paraphrase",
                "speaker_intent",
                "next_action",
                "inference",
                "graphic_integration",
                "word_form",
                "verb_form_agreement",
                "preposition_collocation",
                "connector_clause",
                "vocabulary_in_context",
                "reference_cohesion",
                "sentence_insertion",
                "cross_document",
                "conditions_exceptions",
                "chronology"
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_type", "source_id", "quote_en", "reasoning_zh"],
              "properties": {
                "source_type": {
                  "type": "string",
                  "enum": ["document_block", "audio_segment", "asset", "item_prompt"]
                },
                "source_id": { "type": "string", "minLength": 1 },
                "quote_en": { "type": "string" },
                "reasoning_zh": { "type": "string", "minLength": 1 }
              }
            }
          },
          "explanation_zh": { "type": "string", "minLength": 1 },
          "distractor_notes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["choice_id", "reason_zh"],
              "properties": {
                "choice_id": { "type": "string", "enum": ["A", "B", "C", "D"] },
                "reason_zh": { "type": "string", "minLength": 1 }
              }
            }
          },
          "vocabulary": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term_en", "meaning_zh", "example_en"],
              "properties": {
                "term_en": { "type": "string", "minLength": 1 },
                "meaning_zh": { "type": "string", "minLength": 1 },
                "example_en": { "type": "string", "minLength": 1 }
              }
            }
          },
          "estimated_time_sec": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "author_tool", "author_model", "created_at", "rights_note_zh"],
      "properties": {
        "origin": { "type": "string", "const": "original" },
        "author_tool": { "type": "string", "minLength": 1 },
        "author_model": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "minLength": 1 },
        "rights_note_zh": { "type": "string", "minLength": 1 }
      }
    },
    "review_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
