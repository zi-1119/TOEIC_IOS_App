{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toeic-ios-app.local/schemas/review.schema.json",
  "title": "TOEIC Content Contract 1.0.0 Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "group_id",
    "group_version",
    "item_ids",
    "reviewer_kind",
    "reviewer_name",
    "reviewer_model",
    "reviewed_at",
    "blind",
    "verdict",
    "findings"
  ],
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "group_id": { "type": "string", "minLength": 1 },
    "group_version": { "type": "integer", "minimum": 1 },
    "item_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewer_kind": { "type": "string", "enum": ["ai", "human", "program"] },
    "reviewer_name": { "type": "string", "minLength": 1 },
    "reviewer_model": { "type": ["string", "null"] },
    "reviewed_at": { "type": "string", "minLength": 1 },
    "blind": { "type": "boolean" },
    "verdict": { "type": "string", "enum": ["pass", "revise", "reject"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "severity", "code", "note_zh"],
        "properties": {
          "item_id": { "type": ["string", "null"] },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "code": { "type": "string", "minLength": 1 },
          "note_zh": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
