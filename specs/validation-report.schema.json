{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toeic-ios-app.local/schemas/validation-report.schema.json",
  "title": "Validation Report 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "content_schema_version",
    "batch_id",
    "generated_at",
    "validator",
    "profile",
    "checks",
    "counts",
    "overall_result"
  ],
  "properties": {
    "report_version": { "type": "string", "const": "1.0.0" },
    "content_schema_version": { "type": "string", "const": "1.0.0" },
    "batch_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "profile": { "type": "string", "enum": ["authoring", "release"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "category",
          "target",
          "status",
          "code",
          "message_zh",
          "evidence_paths"
        ],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "structure",
              "references",
              "uniqueness",
              "assets",
              "review_integrity",
              "content_quality",
              "package"
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "group_id", "item_id"],
            "properties": {
              "path": { "type": ["string", "null"] },
              "group_id": { "type": ["string", "null"] },
              "item_id": { "type": ["string", "null"] }
            }
          },
          "status": {
            "type": "string",
            "enum": ["pass", "warning", "fail", "not_run"]
          },
          "code": { "type": "string", "minLength": 1 },
          "message_zh": { "type": "string", "minLength": 1 },
          "evidence_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warning", "fail", "not_run"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 }
      }
    },
    "overall_result": {
      "type": "string",
      "enum": ["pass", "warning", "fail", "incomplete"]
    }
  }
}
